rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar autenticación
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función auxiliar para verificar si es el mismo usuario
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Perfiles de usuario: cada usuario puede leer y editar su perfil
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // Catálogo de servicios: lectura pública, escritura solo administradores
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    // Barberos: lectura pública, escritura administradores o el propio barbero
    match /barbers/{barberId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.token.role == 'admin' || request.auth.uid == resource.data.userId);
    }
    
    // Citas / Reservas (appointments)
    match /appointments/{appointmentId} {
      // El cliente dueño de la cita o el barbero asignado o un admin pueden leer
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.clientId ||
        request.auth.uid == resource.data.barberId ||
        request.auth.token.role == 'admin'
      );
      
      // Creación: usuarios autenticados para sí mismos o clientes invitados
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
      
      // Actualización / Cancelación: dueño de la cita, barbero o admin
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.clientId ||
        request.auth.uid == resource.data.barberId ||
        request.auth.token.role == 'admin'
      );
      
      allow delete: if isAuthenticated() && request.auth.token.role == 'admin';
    }
    
    // Configuración general del negocio
    match /business_config/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.token.role == 'admin';
    }
  }
}
